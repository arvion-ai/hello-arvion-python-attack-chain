# INTENTIONALLY COMMITTED — see README. Real-shape values, none of
# them live secrets. AWS keys use AWS's own documented sample
# format; DATABASE_URL points at a non-routable host.

APP_ENV=production
LOG_LEVEL=INFO

# DB creds — chain's lateral hop into the PII table happens through
# a SQL-injectable handler that uses the connection string below.
DATABASE_URL=postgresql://api_user:hunter2-demo-only@orders-db.internal:5432/customer_orders

# AWS creds — chain's terminal asset is the customer-invoices-prod
# bucket. boto3 picks these up automatically when present.
AWS_ACCESS_KEY_ID=AKIAIOSFODNN7EXAMPLE
AWS_SECRET_ACCESS_KEY=wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY
AWS_DEFAULT_REGION=us-east-1
INVOICE_BUCKET=customer-invoices-prod

# Used as the secret for an in-process JWT — predictable + checked
# into the repo, so anyone can mint a token that bypasses the
# weak auth middleware.
JWT_SECRET=change-me-in-prod
